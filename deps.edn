;; `src-hasch` IS ON THE PATH, not only in the jar. `build.clj` adds it to
;; `write-pom` and `copy-dir`, so a Maven consumer gets `boring.hasch` -- but a
;; `:local/root` or `:git/url` consumer gets THIS `:paths` vector instead, and
;; the comment below names four of them. The result was that
;; `boring.core/hasch-integration?` answered TRUE for a Maven consumer and
;; FALSE for konserve, kabel, konserve-sync and datahike on an otherwise
;; identical classpath -- and the failure mode is exactly the one boring.hasch
;; exists to prevent, since two record types and a plain map then
;; content-address to the same uuid with nothing thrown.
;;
;; Safe for a consumer WITHOUT hasch: the `defonce` at the end of `boring.core`
;; probes `hasch.benc` before `boring.hasch`, which is there so that shipping
;; the namespace cannot break anyone. See the comment on it.
{:paths ["src" "src-hasch" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}

 ;; boring has a Java hot path, so `target/classes` on :paths above is BUILT,
 ;; not checked in. This tells tools.deps how to build it, which is what makes
 ;; boring usable as a source dependency at all: konserve, kabel,
 ;; konserve-sync and datahike all depend on it via :local/root, and without
 ;; this a consumer gets `ClassNotFoundException: org.replikativ.boring.Reader`
 ;; unless someone happened to have run a build in this directory first.
 ;;
 ;; Consumers run `clj -X:deps prep` once; `-Sforce` after boring's Java
 ;; changes. It does NOT apply to the Maven artifact -- that jar already
 ;; carries the compiled classes -- only to :local/root and :git/url deps.
 :deps/prep-lib {:ensure "target/classes"
                 :alias :build
                 :fn javac}

 :aliases
 {:dev
  {:extra-paths ["dev" "test" "bench"]
   :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   ;; No --enable-native-access: the hot path is byte[] + VarHandle, not FFM,
   ;; so it needs no native-access grant on any JDK.
   :jvm-opts ["-server" "-Xmx4g" "-Dclojure.compiler.direct-linking=true"]}

  :test
  {:extra-paths ["test" "target/classes"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   ;; A HEAP CEILING, because without one the suite MISREPORTS resource
   ;; exhaustion as a codec defect. `generative-test/decode-outcome` catches
   ;; Throwable and classifies OutOfMemoryError as `:untyped` -- the category
   ;; that means "boring let a raw host exception escape" -- so a tight heap
   ;; turns into a correctness failure, and it fires hardest during test.check
   ;; SHRINKING, exactly when the diagnostic is needed. Seen twice: a green
   ;; suite, then an OOM inside a rose-tree generator, on unchanged code.
   ;;
   ;; `:dev` and `:bench` both set -Xmx4g; this alias set nothing, so it took
   ;; the JVM default -- 25% of a CI container is about 1 GB. 2g is comfortably
   ;; above the real peak (`writer-streaming-test` holds five boxed copies of a
   ;; generated value live at once) and low enough to stay honest.
   :jvm-opts ["-Xmx2g"]
   :main-opts ["-m" "cognitect.test-runner"]}

  ;; boring measured against nippy's own reference stress data. Isolated in its
  ;; own source root and alias so an EPL-1.0 dependency never reaches the
  ;; classpath of the Apache-2.0 library's main test suite -- boring CALLS
  ;; `stress-data`, it does not vendor it. See NOTICE.
  :nippy-stress
  {:extra-paths ["test-nippy" "target/classes"]
   :extra-deps {com.taoensso/nippy {:mvn/version "3.9.0-beta1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-nippy"]
   ;; boring measured on nippy's own benchmark:
   ;;   clojure -M:nippy-bench
}

  :nippy-bench
  {:extra-paths ["test-nippy" "target/classes"]
   ;; zstd-jni so boring's compressed tiers can be measured on nippy's own
   ;; payload. nippy/freeze compresses by itself; reporting boring's raw bytes
   ;; against it compares a codec with a codec-plus-compressor.
   :extra-deps {com.taoensso/nippy {:mvn/version "3.9.0-beta1"}
                com.github.luben/zstd-jni {:mvn/version "1.5.6-8"}
                org.clojure/data.fressian {:mvn/version "1.1.0"}}
   :main-opts ["-m" "boring.nippy-bench"]}

  ;; The fuzzer, split out of :bench so CI can run it.
  ;;
  ;; `bin/ci fuzz` used :bench, which drags in `com.s-exp/hako` -- a comparison
  ;; peer that is NOT published to Central or Clojars and only exists after a
  ;; local `clj -T:build install` from ../hako. That resolves on a machine that
  ;; has done it and nowhere else, so the alias guard in bin/ci could not catch
  ;; it (it DOES resolve locally, from ~/.m2) and the first CircleCI run died
  ;; with "Could not find artifact com.s-exp:hako:jar:1.0.0-alpha35".
  ;;
  ;; fuzz.clj needs boring and test.check. Nothing else belongs here.
  :fuzz
  {:extra-paths ["bench" "test" "target/classes"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}
   :main-opts ["-m" "fuzz"]}

  ;; Peers for comparative benchmarking. LOCAL ONLY -- hako needs a local
  ;; `clj -T:build install` from ../hako and JDK 25, so no CI job may use this
  ;; alias. See :fuzz above for what that cost us.
  :bench
  {:extra-paths ["bench" "test" "target/classes"]
   :extra-deps {criterium/criterium {:mvn/version "0.4.6"}
                com.taoensso/nippy {:mvn/version "3.9.0-beta1"}
                mvxcvi/clj-cbor {:mvn/version "1.1.1"}
                com.s-exp/hako {:mvn/version "1.0.0-alpha35"}
                org.clojure/data.fressian {:mvn/version "1.1.0"}
                com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}
                com.fasterxml.jackson.dataformat/jackson-dataformat-cbor {:mvn/version "2.18.2"}
                ;; bench/compressors.clj only. konserve keeps zstd-jni optional
                ;; for its users; a benchmark alias has no such obligation.
                com.github.luben/zstd-jni {:mvn/version "1.5.6-8"}
                org.lz4/lz4-java {:mvn/version "1.8.0"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   ;; --enable-native-access is for hako, not for boring.
   ;; DebugNonSafepoints gives async-profiler accurate inlined frames.
   :jvm-opts ["-server" "-Xmx4g" "-Dclojure.compiler.direct-linking=true"
              "--enable-native-access=ALL-UNNAMED"
              "-XX:+UnlockDiagnosticVMOptions" "-XX:+DebugNonSafepoints"
              "-Djdk.attach.allowAttachSelf"]}

  ;; The optional hasch integration. hasch is NOT a runtime dependency of
  ;; boring -- this alias exists to test the namespace, and a consumer who
  ;; requires boring.hasch supplies hasch themselves.
  :hasch
  {:extra-paths ["src-hasch" "test-hasch"]
   :extra-deps {org.replikativ/hasch {:mvn/version "0.4.100"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "test-hasch"]}

  ;; Interactive development. Carries the :bench peers so nippy, hako and
  ;; criterium are available for comparison at the REPL.
  :nrepl
  {:extra-paths ["bench" "test" "test-nippy" "target/classes"]
   :extra-deps {nrepl/nrepl {:mvn/version "1.3.0"}
                criterium/criterium {:mvn/version "0.4.6"}
                com.taoensso/nippy {:mvn/version "3.9.0-beta1"}
                com.s-exp/hako {:mvn/version "1.0.0-alpha35"}
                org.clojure/data.fressian {:mvn/version "1.1.0"}
                org.clojure/test.check {:mvn/version "1.1.1"}}
   :jvm-opts ["-server" "-Xmx4g" "--enable-native-access=ALL-UNNAMED"]
   :main-opts ["-m" "nrepl.cmdline" "--port" "47921"]}

  ;; `-T:build`. The gh-release-artifact deps are what the clj-tools orb's
  ;; `tools/release` job needs; konserve carries the same set.
  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}
          slipset/deps-deploy {:mvn/version "0.2.2"}
          io.github.borkdude/gh-release-artifact
          {:git/sha "b946558225a7839f6a0f644834e838e190dc2262"}
          babashka/babashka.curl {:mvn/version "0.1.2"}
          babashka/fs {:mvn/version "0.3.17"}
          cheshire/cheshire {:mvn/version "5.11.0"}}
   :ns-default build}

  ;; Same names as the rest of replikativ, so the shared CircleCI orb finds them.
  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check" "src" "test" "dev" "bench"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix" "src" "test" "dev" "bench"]}

  :lint
  {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
   :main-opts ["-m" "clj-kondo.main" "--lint" "src"]}

  ;; The ClojureScript path CI uses. Deps only — pass cljs.main args yourself.
  ;;
  ;; Deliberately has NO :local/root entry. It used to depend on
  ;; `com.github.pkpkpk/fress {:local/root "../fress"}`, which resolves on a
  ;; machine that happens to have that checkout as a sibling and NOWHERE else:
  ;; a fresh clone failed every CLJS job with "Local lib not found" before it
  ;; compiled a line. fress is a benchmark peer, needed only by
  ;; cljsbench.baseline and cljsbench.compare, so it belongs in :cljs-bench.
  :cljs-deps
  {:extra-paths ["bench/cljs" "test"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                org.clojure/test.check {:mvn/version "1.1.1"}}}

  ;; The CLJS competitive table in doc/PERFORMANCE.md. Deps only, no :main-opts:
  ;; an alias that carries :main-opts silently swallows the cljs.main flags you
  ;; pass after -M, so `-o target/x.js -c cljsbench.compare` exited 0 and wrote
  ;; nothing. Run:
  ;;
  ;;   clojure -M:cljs-compare -m cljs.main -co '{:language-in :ecmascript-next}' \
  ;;     -O advanced -t node -o target/cljs-compare.js -c cljsbench.compare
  ;;   node target/cljs-compare.js
  :cljs-compare
  {:extra-paths ["bench/cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                com.github.pkpkpk/fress {:local/root "../fress"}
                com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}

  ;; CLJS incumbent baseline: fress vs transit-cljs, establishing the bar the
  ;; port had to clear. fress comes from a local checkout so we measure exactly
  ;; the code in ../fress — which is why this alias, and not :cljs-deps, is the
  ;; one that needs it. Local benchmarking only; CI never runs it.
  :cljs-bench
  {:extra-paths ["bench/cljs"]
   :extra-deps {org.clojure/clojurescript {:mvn/version "1.12.145"}
                com.github.pkpkpk/fress {:local/root "../fress"}
                com.cognitect/transit-cljs {:mvn/version "0.8.280"}}
   :main-opts ["-m" "cljs.main"
               "-co" "{:language-in :ecmascript-next}"
               "-O" "advanced"
               "-t" "node"
               "-o" "target/cljs-baseline.js"
               "-c" "cljsbench.baseline"]}}}
