;; The published documentation tree. A doc/ file that is not listed here does
;; not exist on cljdoc, and a "see doc/X.md" in a docstring renders as a dead
;; reference rather than a link.
;;
;; doc/STORAGE.md was missing while README.md, three `boring.core` docstrings
;; (`encode`, `write-seq!`, `write-indexed!`), `boring.mmap/segment-sink` and
;; SegmentSink.java all pointed at it -- seven references to a page cljdoc had
;; never been told about. Add the entry in the same commit as the file.
{:cljdoc.doc/tree
 [["Readme" {:file "README.md"}]
  ["Guides" {}
   ["Interop with other languages" {:file "doc/INTEROP.md"}]
   ["Storage" {:file "doc/STORAGE.md"}]
   ["Extending" {:file "doc/EXTENDING.md"}]
   ["Performance" {:file "doc/PERFORMANCE.md"}]
   ["Datahike dump codec" {:file "doc/MIGRATE-CODEC.md"}]]
  ["Format" {}
   ["Compatibility policy" {:file "doc/COMPATIBILITY.md"}]
   ["Shapes" {:file "doc/SHAPES.md"}]
   ["Security" {:file "doc/SECURITY.md"}]
   ["IANA registration" {:file "doc/IANA-REGISTRATION.md"}]]
  ]}
