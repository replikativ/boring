(ns cljsbench.probe-fix)

(defn unhex [s]
  (let [n (quot (count s) 2)
        b #?(:clj (byte-array n) :cljs (js/Uint8Array. n))]
    (dotimes [i n]
      (let [v #?(:clj (Integer/parseInt (subs s (* 2 i) (+ 2 (* 2 i))) 16)
                 :cljs (js/parseInt (subs s (* 2 i) (+ 2 (* 2 i))) 16))]
        #?(:clj (aset-byte b i (unchecked-byte v)) :cljs (aset b i v))))
    b))

(defn cut
  "First `n` bytes."
  [b n]
  #?(:clj (java.util.Arrays/copyOf ^bytes b (int n))
     :cljs (.slice b 0 n)))

